{
  "name": "neodeol-client",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Neodeol 클라이언트 — 정수 서브픽셀 시뮬레이션 (Phase 2)",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "npm run check:nofloat && npm run check:mirror && npm run test:determinism && npm run test:mapgen && npm run test:prototype-ai",
    "test:mapgen": "node --experimental-strip-types --no-warnings --test tests/mapgen-variety.mts",
    "check:nofloat": "node tools/check-no-float.mjs",
    "test:determinism": "node --experimental-strip-types --no-warnings tests/determinism.mts",
    "test:cross-sim": "node --experimental-strip-types --no-warnings tests/cross-sim.mts",
    "gen:trig": "python3 ../tools/gen_trig.py",
    "typecheck": "tsc --noEmit",
    "check:mirror": "node --no-warnings tools/build-browser-sim.mjs --check",
    "test:prototype-ai": "node --test tests/ai-difficulty.mjs tests/flight-playback.mjs && node --no-warnings tests/prototype-ai.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
