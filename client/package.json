{
  "name": "talus-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Talus 클라이언트 — 정수 서브픽셀 시뮬레이션 (Phase 2)",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "test": "npm run check:nofloat && npm run test:determinism",
    "check:nofloat": "node tools/check-no-float.mjs",
    "test:determinism": "node --experimental-strip-types --no-warnings tests/determinism.mts",
    "test:cross-sim": "node --experimental-strip-types --no-warnings tests/cross-sim.mts",
    "gen:trig": "python3 ../tools/gen_trig.py",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
